# Application Configuration
NEXT_PUBLIC_APP_URL=https://bcs.vartualtutor.com
NEXT_PUBLIC_APP_NAME="BCS Crack"
NEXT_PUBLIC_APP_ENV=production
PORT=3000
HOSTNAME="0.0.0.0"

# Supabase & PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Private Service Key (Keep secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI Provider Configuration (Server-Side Only)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-1.5-flash
AI_REQUEST_TIMEOUT_MS=15000

# Session Security
NEXTAUTH_SECRET=generate_a_random_32_byte_hex_string_here
SESSION_SECRET=generate_a_random_32_byte_hex_string_here
NEXTAUTH_URL=https://bcs.vartualtutor.com

# Google OAuth 2.0 Credentials
# Authorized redirect URI in Google Cloud Console: https://bcs.vartualtutor.com/api/auth/google/callback
GOOGLE_CLIENT_ID=335688416251-9jscemnna8crp4hmggabsniqtb7okbg1.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=335688416251-9jscemnna8crp4hmggabsniqtb7okbg1.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Authoritative Super Admin Registry & Bootstrap Password
SUPER_ADMIN_PASSWORD=your_secure_random_super_admin_password_here
SUPER_ADMIN_EMAILS=istihadahmed1163@gmail.com,istihadahmed007@gmail.com,admin@bcs.vartualtutor.com

# Payment Gateway: Paymently (Virtual Tutor Direct Link & QR)
PAYMENTLY_DEFAULT_LINK=https://vartualtutor.paymently.io/paymentlink/default/BDT

# Payment Gateway: SSLCommerz (Production)
SSLCOMMERZ_STORE_ID=your_production_store_id
SSLCOMMERZ_STORE_PASSWD=your_production_store_passwd
SSLCOMMERZ_IS_SANDBOX=false

# Payment Gateway: aamarPay (Production)
