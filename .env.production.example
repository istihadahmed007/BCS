# ====================================================================
# BCS Crack — Production Environment Configuration for Hostinger
# Domain: https://bcs.vartualtutor.com
# ====================================================================

# Application Configuration
NEXT_PUBLIC_APP_URL=https://bcs.vartualtutor.com
NEXT_PUBLIC_APP_NAME="BCS Crack"
NEXT_PUBLIC_APP_ENV=production
PORT=3000
HOSTNAME="0.0.0.0"

# Supabase & PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Private Service Key (Keep secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI Provider Configuration (Server-Side Only)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-1.5-flash
AI_REQUEST_TIMEOUT_MS=15000

# Session Security
NEXTAUTH_SECRET=generate_a_random_32_byte_hex_string_here
NEXTAUTH_URL=https://bcs.vartualtutor.com
