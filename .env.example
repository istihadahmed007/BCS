# ====================================================================
# BCS Crack — Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit private API keys or database service-role secrets.
# ====================================================================

# --------------------------------------------------------------------
# Application Configuration
# --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="BCS Crack"
NEXT_PUBLIC_APP_ENV=development

# --------------------------------------------------------------------
# Supabase & PostgreSQL Configuration
# --------------------------------------------------------------------
# Connect to Supabase via connection pooling (port 6543) or direct (port 5432)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Public Keys (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Private Keys (Server-side ONLY — do NOT prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --------------------------------------------------------------------
# AI Provider Configuration (Server-Side Only)
# --------------------------------------------------------------------
# Supported providers: gemini | openai | claude | mock
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-1.5-flash
AI_REQUEST_TIMEOUT_MS=15000

# --------------------------------------------------------------------
# Session Security
# --------------------------------------------------------------------
NEXTAUTH_SECRET=generate_a_random_32_byte_hex_string_here
SESSION_SECRET=generate_a_random_32_byte_hex_string_here
NEXTAUTH_URL=http://localhost:3000

# --------------------------------------------------------------------
# Google OAuth 2.0 Credentials (Google Cloud Console)
# --------------------------------------------------------------------
# Authorized redirect URI: [YOUR_DOMAIN]/api/auth/google/callback
# Local redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --------------------------------------------------------------------
# Payment Gateway: SSLCommerz (Bangladesh)
# --------------------------------------------------------------------
# Set SSLCOMMERZ_IS_SANDBOX=false for live production transactions
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASSWD=your_sslcommerz_store_password
SSLCOMMERZ_IS_SANDBOX=true

# --------------------------------------------------------------------
# Payment Gateway: aamarPay (Bangladesh)
# --------------------------------------------------------------------
# Set AAMARPAY_IS_SANDBOX=false for live production transactions
AAMARPAY_STORE_ID=your_aamarpay_store_id
AAMARPAY_SIGNATURE_KEY=your_aamarpay_signature_key
AAMARPAY_IS_SANDBOX=true
